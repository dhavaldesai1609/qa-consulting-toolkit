{
  "name": "playwright-boilerplate",
  "version": "1.1.0",
  "description": "Production-ready Playwright + TypeScript boilerplate with modern helpers (Excel, DB, API, data factories, logging) for consulting engagements",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "test-automation", "qa", "boilerplate", "excel", "database"],
  "author": "Dhaval B. Desai",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "allure-playwright": "^3.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.5.0",
    "pg": "^8.13.0",
    "mysql2": "^3.11.0",
    "mssql": "^11.0.0",
    "dotenv": "^16.4.0",
    "winston": "^3.14.0",
    "@faker-js/faker": "^9.0.0",
    "date-fns": "^4.1.0",
    "zod": "^3.23.0"
  }
}
