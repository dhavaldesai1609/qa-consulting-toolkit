# Copy to .env and fill in values. Never commit .env.

# Application under test
BASE_URL=https://example.com
API_BASE_URL=https://api.example.com

# Test credentials (use CI secrets in pipelines)
TEST_USER=
TEST_PASSWORD=

# Database (optional)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testdb
DB_USER=testuser
DB_PASSWORD=
DB_SSL=false

# Runtime
LOG_LEVEL=info
HEADLESS=true
CI=false
